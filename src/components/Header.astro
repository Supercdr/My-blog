---
import { siteConfig } from "@/config";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.title}首页`}>
      <span class="brand-mark" aria-hidden="true">ZY</span>
      <span class="brand-name">{siteConfig.title}</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {
        siteConfig.nav.map((item) => (
          <a class:list={["nav-link", { active: isActive(item.href) }]} href={item.href}>
            {item.label}
          </a>
        ))
      }
      <a class="nav-rss" href="/rss.xml" aria-label="订阅 RSS">
        RSS
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding: 1.35rem 0 0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--ink);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1;
  }

  .brand-name {
    font-family: var(--serif);
    font-size: 1.08rem;
    font-weight: 600;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.2rem 0.15rem;
  }

  .nav-link,
  .nav-rss {
    position: relative;
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    padding: 0.15rem 0.62rem;
    color: var(--muted);
    font-size: 0.84rem;
    text-decoration: none;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .nav-link:hover,
  .nav-rss:hover,
  .nav-link.active {
    color: var(--ink);
  }

  .nav-link.active::after {
    position: absolute;
    right: 0.62rem;
    bottom: 0.05rem;
    left: 0.62rem;
    height: 1px;
    background: var(--accent);
    content: "";
  }

  .nav-rss {
    margin-left: 0.25rem;
    border-left: 1px solid var(--line);
    color: var(--accent);
  }

  @media (max-width: 620px) {
    .site-header {
      padding-top: 1rem;
    }

    .header-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.65rem;
    }

    .site-nav {
      width: 100%;
      justify-content: flex-start;
    }

    .nav-link:first-child {
      padding-left: 0;
    }

    .nav-link.active::after {
      right: 0.62rem;
      left: 0.62rem;
    }

    .nav-link:first-child.active::after {
      left: 0;
    }
  }
</style>
