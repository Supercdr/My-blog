---
import ArticleCard from "@/components/ArticleCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  collectTags,
  getPublishedPosts,
  getTagHref,
  tagSlug
} from "@/utils/content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = collectTags(posts);

  return [...tags.entries()].map(([tag, entries]) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: entries }
  }));
}

const { tag, posts } = Astro.props;
const allTags = [...collectTags(await getPublishedPosts()).keys()];
---

<BaseLayout
  title={`标签：${tag}`}
  description={`浏览“${tag}”标签下的全部文章。`}
>
  <section class="page-section">
    <div class="container">
      <div class="page-heading">
        <p class="page-kicker">Topic</p>
        <h1>{tag}</h1>
        <p>共有 {posts.length} 篇文章归入这个标签。</p>
      </div>

      <nav class="tag-navigation" aria-label="切换标签">
        <a class="tag-chip" href="/blog">全部</a>
        {
          allTags.map((item) => (
            <a class:list={["tag-chip", { active: item === tag }]} href={getTagHref(item)}>
              {item}
            </a>
          ))
        }
      </nav>

      <div class="tag-post-list">
        {posts.map((post, index) => <ArticleCard post={post} index={index} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tag-navigation {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 2.2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .tag-post-list {
    margin-top: 0.25rem;
  }
</style>
