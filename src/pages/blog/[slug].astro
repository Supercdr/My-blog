---
import { render } from "astro:content";
import { ArrowLeft, ArrowRight } from "lucide-astro";
import ArticleShare from "@/components/ArticleShare.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig, withBase } from "@/config";
import {
  formatDate,
  getPostHref,
  getPublishedPosts,
  getTagHref
} from "@/utils/content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previousPost: posts[index - 1] ?? null,
      nextPost: posts[index + 1] ?? null
    }
  }));
}

const { post, previousPost, nextPost } = Astro.props;
const { Content } = await render(post);
const siteURL = Astro.site ?? new URL("https://example.com");
const postURL = new URL(getPostHref(post), siteURL).toString();
const section = post.data.tags[0] ?? "文章";
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  schema={{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    mainEntityOfPage: postURL,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: {
      "@type": "Person",
      name: siteConfig.author
    },
    keywords: post.data.tags.join(", "),
    inLanguage: "zh-CN"
  }}
>
  <article class="article-page">
    <header class="container article-header">
      <a class="back-link" href={withBase("/blog")}>
        <ArrowLeft size={14} stroke-width={1.8} aria-hidden="true" />
        返回文章列表
      </a>
      <p class="article-section">{section}</p>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>

      <div class="article-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {
          post.data.updatedDate && (
            <span>更新于 {formatDate(post.data.updatedDate)}</span>
          )
        }
        <span>{siteConfig.author}</span>
      </div>

      {
        post.data.tags.length > 0 && (
          <div class="article-tags">
            {post.data.tags.map((tag) => (
              <a class="tag-chip" href={getTagHref(tag)}>
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="container article-body">
      <div class="article-divider" aria-hidden="true"></div>
      <div class="prose">
        <Content />
      </div>
      <ArticleShare title={post.data.title} url={postURL} />
    </div>

    <nav class="container article-navigation" aria-label="文章导航">
      {
        previousPost ? (
          <a class="article-nav-link previous" href={getPostHref(previousPost)}>
            <span class="nav-direction">
              <ArrowLeft size={14} stroke-width={1.8} aria-hidden="true" />
              上一篇
            </span>
            <strong>{previousPost.data.title}</strong>
          </a>
        ) : (
          <span></span>
        )
      }
      {
        nextPost && (
          <a class="article-nav-link next" href={getPostHref(nextPost)}>
            <span class="nav-direction">
              下一篇
              <ArrowRight size={14} stroke-width={1.8} aria-hidden="true" />
            </span>
            <strong>{nextPost.data.title}</strong>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .article-header {
    max-width: 860px;
    padding-top: 4.8rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    color: var(--muted);
    font-size: 0.78rem;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .article-section {
    margin: 2.6rem 0 0.8rem;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 600;
  }

  h1 {
    max-width: 50rem;
    margin: 0;
    font-family: var(--serif);
    font-size: 3.45rem;
    font-weight: 600;
    line-height: 1.24;
  }

  .article-description {
    max-width: 45rem;
    margin: 1.3rem 0 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 1.08rem;
    line-height: 1.9;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-top: 1.6rem;
    color: var(--muted-light);
    font-size: 0.76rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.3rem;
  }

  .article-body {
    max-width: 760px;
    margin-top: 3rem;
  }

  .article-divider {
    width: 3.75rem;
    height: 2px;
    margin-bottom: 2.8rem;
    background: var(--accent);
  }

  .article-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .article-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
  }

  .article-nav-link.next {
    text-align: right;
  }

  .article-nav-link strong {
    font-family: var(--serif);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.55;
  }

  .article-nav-link:hover strong {
    color: var(--accent);
  }

  .nav-direction {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted-light);
    font-size: 0.72rem;
  }

  .article-nav-link.next .nav-direction {
    justify-content: flex-end;
  }

  @media (max-width: 700px) {
    .article-header {
      padding-top: 3.5rem;
    }

    h1 {
      font-size: 2.45rem;
    }

    .article-description {
      font-size: 1rem;
    }

    .article-navigation {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .article-nav-link.next {
      text-align: left;
    }

    .article-nav-link.next .nav-direction {
      justify-content: flex-start;
    }
  }
</style>
