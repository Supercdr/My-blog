---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="页面未找到" description="这个页面不存在，或者已经被移动。">
  <section class="not-found">
    <div class="container">
      <p class="error-code">404</p>
      <h1>这里没有内容。</h1>
      <p>可能是链接已经失效，也可能只是暂时还没有写下这一页。</p>
      <a class="back-home" href="/">返回首页</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-top: 8rem;
  }

  .error-code {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
  }

  h1 {
    margin: 0;
    font-family: var(--serif);
    font-size: 3.3rem;
    font-weight: 600;
  }

  .not-found p:not(.error-code) {
    margin: 1rem 0 0;
    color: var(--muted);
  }

  .back-home {
    display: inline-block;
    margin-top: 1.8rem;
    color: var(--accent);
    text-underline-offset: 0.25em;
  }

  @media (max-width: 700px) {
    .not-found {
      padding-top: 5rem;
    }

    h1 {
      font-size: 2.5rem;
    }
  }
</style>
