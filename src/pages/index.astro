---
import ArticleCard from "@/components/ArticleCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig, withBase } from "@/config";
import {
  collectTags,
  formatDate,
  getPublishedPosts,
  getTagHref
} from "@/utils/content";

const posts = await getPublishedPosts();
const tags = [...collectTags(posts).entries()];
const latestPost = posts[0];
---

<BaseLayout
  schema={{
    "@context": "https://schema.org",
    "@type": "Blog",
    name: siteConfig.title,
    description: siteConfig.description,
    author: {
      "@type": "Person",
      name: siteConfig.author
    }
  }}
>
  <section class="home-intro">
    <div class="container home-intro-grid">
      <div class="intro-copy">
        <p class="eyebrow">写作 · 设计 · 技术 · 日常</p>
        <h1>在快速的世界里，<br />练习慢一点想清楚。</h1>
        <p class="intro-lede">{siteConfig.description}</p>
        {
          latestPost && (
            <p class="latest-note">
              最近更新于 <time datetime={latestPost.data.pubDate.toISOString()}>
                {formatDate(latestPost.data.pubDate)}
              </time>
            </p>
          )
        }
      </div>
      <p class="intro-side">
        Essays on the things<br />
        worth thinking twice.
      </p>
    </div>
  </section>

  <figure class="container home-visual">
    <img
      src={withBase("/images/quiet-desk.png")}
      alt="清晨窗边放着纸张、钢笔和一杯咖啡的安静桌面"
      width="1536"
      height="1024"
    />
    <figcaption>让信息沉淀下来，再变成文字。</figcaption>
  </figure>

  <section class="container home-content">
    <div class="post-list">
      <div class="section-heading">
        <h2>近期文章</h2>
        <a href={withBase("/blog")}>查看全部</a>
      </div>
      {posts.slice(0, 4).map((post, index) => <ArticleCard post={post} index={index} />)}
    </div>

    <aside class="home-aside">
      <section class="aside-section">
        <p class="aside-label">现在</p>
        <p class="aside-text">
          持续关注长期写作、设计判断，以及技术如何让复杂的事情变得清楚。
        </p>
      </section>

      <section class="aside-section">
        <p class="aside-label">常写的话题</p>
        <div class="tag-cloud">
          {
            tags.slice(0, 8).map(([tag, entries]) => (
              <a class="tag-chip" href={getTagHref(tag)}>
                {tag}
                <span class="tag-count">{entries.length}</span>
              </a>
            ))
          }
        </div>
      </section>
    </aside>
  </section>
</BaseLayout>

<style>
  .home-intro {
    padding-top: 4.6rem;
  }

  .home-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3rem;
    align-items: end;
  }

  .intro-copy h1 {
    max-width: 54rem;
    margin: 0;
    font-family: var(--serif);
    font-size: 4.15rem;
    font-weight: 600;
    line-height: 1.22;
  }

  .intro-lede {
    max-width: 40rem;
    margin: 1.45rem 0 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.9;
  }

  .latest-note {
    margin: 1.5rem 0 0;
    color: var(--muted-light);
    font-size: 0.78rem;
  }

  .latest-note time {
    color: var(--accent);
  }

  .intro-side {
    margin: 0 0 0.4rem;
    color: var(--muted-light);
    font-family: var(--serif);
    font-size: 0.8rem;
    font-style: italic;
    line-height: 1.7;
    text-align: right;
  }

  .home-visual {
    margin-top: 3rem;
  }

  .home-visual img {
    width: 100%;
    aspect-ratio: 16 / 4.6;
    object-fit: cover;
  }

  .home-visual figcaption {
    margin-top: 0.75rem;
    color: var(--muted-light);
    font-size: 0.72rem;
    text-align: right;
  }

  .home-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 5rem;
    margin-top: 3.25rem;
  }

  .home-aside {
    display: grid;
    align-content: start;
    gap: 2.8rem;
    padding-top: 0.3rem;
  }

  .aside-section {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .aside-label {
    margin: 0 0 0.7rem;
    color: var(--accent);
    font-size: 0.74rem;
    font-weight: 600;
  }

  .aside-text {
    margin: 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.85;
  }

  @media (max-width: 960px) {
    .home-intro-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .intro-copy h1 {
      font-size: 3.35rem;
    }

    .intro-side {
      text-align: left;
    }

    .home-content {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .home-aside {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .home-intro {
      padding-top: 3rem;
    }

    .intro-copy h1 {
      font-size: 2.38rem;
    }

    .intro-lede {
      font-size: 0.94rem;
    }

    .home-visual {
      margin-top: 2rem;
    }

    .home-visual img {
      aspect-ratio: 3 / 2;
    }

    .home-content {
      margin-top: 3rem;
    }

    .home-aside {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>
